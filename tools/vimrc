" Quit helpers: :q is the default; :exit behaves the same
cnoreabbrev exit q

" Enable mouse clicks
set mouse=a

" Line number
set number

" New splits open right / below, and switching files keeps unsaved buffers
" open in the background instead of failing with E37 -- both like Neovim.
set splitright
set splitbelow
set hidden

" show existing tab with 4 spaces width
set tabstop=4

" when indenting with '>', use 4 spaces width
set shiftwidth=4

" On pressing tab, insert 4 spaces
set expandtab

" Tab navigation. These shadow Vim's T{char} till-backwards motion for the
" characters n, p, and the digits -- motions nobody uses in practice. Note the
" count for {count}T{char} precedes the T, so T1..T9 cannot collide with it.
" Kept outside the vim-plug block: these need no plugin.
nnoremap <silent> Tn :tabnext<CR>
nnoremap <silent> Tp :tabprevious<CR>
for s:tab in range(1, 9)
    execute 'nnoremap <silent> T' . s:tab . ' :' . s:tab . 'tabnext<CR>'
endfor
unlet s:tab

nnoremap <silent> <Leader>w :write<CR>
nnoremap <silent> <Leader>q :quit<CR>

" Splits use the same second key as WezTerm/tmux (Ctrl+b % / " / z / x),
" with <Space> in place of Ctrl+b. Same in tools/nvim/init.lua.
nnoremap <silent> <Leader>% :vsplit<CR>
nnoremap <silent> <Leader>" :split<CR>
nnoremap <silent> <Leader>x :close<CR>
function! s:ToggleZoom() abort
    if get(t:, 'zoomed', 0)
        wincmd =
    else
        wincmd _ | wincmd |
    endif
    let t:zoomed = !get(t:, 'zoomed', 0)
endfunction
nnoremap <silent> <Leader>z :call <SID>ToggleZoom()<CR>
nnoremap <silent> <Leader>H :vertical resize -5<CR>
nnoremap <silent> <Leader>L :vertical resize +5<CR>
nnoremap <silent> <Leader>J :resize +5<CR>
nnoremap <silent> <Leader>K :resize -5<CR>

" Ctrl+h/j/k/l: move between splits, and into the neighbouring WezTerm/tmux
" pane at the edge (tools/wezterm.lua and tools/tmux.conf pass the keys here).
function! s:Navigate(dir) abort
    let l:before = winnr()
    execute 'wincmd ' . a:dir
    if winnr() != l:before
        return
    endif
    if exists('$TMUX')
        call system('tmux select-pane -' . {'h': 'L', 'j': 'D', 'k': 'U', 'l': 'R'}[a:dir])
    elseif exists('$WEZTERM_PANE') && executable('wezterm')
        call system('wezterm cli activate-pane-direction ' . {'h': 'Left', 'j': 'Down', 'k': 'Up', 'l': 'Right'}[a:dir])
    endif
endfunction
for s:dir in ['h', 'j', 'k', 'l']
    execute 'nnoremap <silent> <C-' . s:dir . '> :call <SID>Navigate("' . s:dir . '")<CR>'
endfor
unlet s:dir

" <Space>e: browse files with lf in a popup, same keys as in the shell:
" Enter opens in a new tab, l opens here, Enter on a directory cds there.
" tools/lfrc writes the pick to $LF_PICK instead of opening its own editor.
function! s:LfDone(pick, ...) abort
    let l:lines = filereadable(a:pick) ? readfile(a:pick) : []
    call delete(a:pick)
    let l:parts = matchlist(get(l:lines, 0, ''), '^\(\a\+\)\t\(.\+\)$')
    if empty(l:parts)
        return
    endif
    let l:cmd = get({'here': 'edit', 'tab': 'tabedit', 'cd': 'cd'}, l:parts[1], '')
    if l:cmd !=# ''
        execute l:cmd . ' ' . fnameescape(l:parts[2])
    endif
endfunction

function! s:LfOpen() abort
    if !executable('lf')
        echohl ErrorMsg | echomsg 'lf is not installed' | echohl None
        return
    endif
    let l:pick = tempname()
    let l:file = expand('%:p')
    let l:target = filereadable(l:file) ? l:file : getcwd()
    let l:buf = term_start(['lf', l:target], {
    \   'hidden': 1,
    \   'term_finish': 'close',
    \   'env': {'LF_PICK': l:pick},
    \   'exit_cb': {-> timer_start(10, function('s:LfDone', [l:pick]))},
    \ })
    call popup_create(l:buf, {
    \   'minwidth': float2nr(&columns * 0.85), 'minheight': float2nr(&lines * 0.8),
    \   'border': [], 'borderchars': ['─', '│', '─', '│', '╭', '╮', '╯', '╰'],
    \ })
endfunction
nnoremap <silent> <Leader>e :call <SID>LfOpen()<CR>

" pstash (tools/pstash): stash prompts for later, same store as the shell.
" <Space>s stashes the selected lines (visual) or asks for a one-liner
" (normal); :Pstash [list | pop n | peek n] runs the shell command.
function! s:Pstash(args, ...) abort
    if !executable('pstash')
        echohl ErrorMsg | echomsg 'pstash is not installed' | echohl None
        return
    endif
    let l:cmd = join(['pstash'] + map(copy(a:args), 'shellescape(v:val)'), ' ')
    let l:out = a:0 ? system(l:cmd, a:1) : system(l:cmd)
    for l:line in split(l:out, "\n")
        echomsg l:line
    endfor
endfunction
function! s:PstashInput() abort
    let l:text = input('Stash prompt: ')
    redraw
    if l:text !=# ''
        call s:Pstash(['-'], l:text)
    endif
endfunction
xnoremap <silent> <Leader>s :<C-u>call <SID>Pstash(['-'], join(getline("'<", "'>"), "\n"))<CR>
nnoremap <silent> <Leader>s :call <SID>PstashInput()<CR>
command! -nargs=* Pstash call s:Pstash(empty([<f-args>]) ? ['list'] : [<f-args>])

" Context agents: :Cclaude / :Ccursor / :Copencode open that agent in a split
" beside the editor (WezTerm/tmux pane, else :terminal), seeded with this
" session's open tabs + dirty files. :Ccontext previews the context first.
" Kept outside the vim-plug block: these need no plugin.
" Unlike nvim, vim's system() takes a String only, so argv lists get
" shellescape-joined before they are run through 'shell'.
function! s:AgentSh(cmd) abort
    return join(map(copy(a:cmd), 'shellescape(v:val)'), ' ')
endfunction

function! s:AgentRoot() abort
    let l:cwd = getcwd()
    let l:root = systemlist(s:AgentSh(['git', '-C', l:cwd, 'rev-parse', '--show-toplevel']))
    if v:shell_error == 0 && get(l:root, 0, '') !=# ''
        return l:root[0]
    endif
    return l:cwd
endfunction

" Absolute paths of dirty + untracked files, or {} outside a git repo.
" Mirrors gopen (tools/zshrc): diff HEAD plus untracked, both from repo root.
function! s:AgentDirty(root) abort
    let l:inside = systemlist(s:AgentSh(['git', '-C', a:root, 'rev-parse', '--is-inside-work-tree']))
    if v:shell_error != 0 || get(l:inside, 0, '') !=# 'true'
        return {}
    endif
    let l:names = systemlist(s:AgentSh(['git', '-C', a:root, 'diff', '--name-only', 'HEAD']))
    if v:shell_error != 0
        let l:names = []
    endif
    let l:extra = systemlist(s:AgentSh(['git', '-C', a:root, 'ls-files', '--others', '--exclude-standard']))
    if v:shell_error != 0
        let l:extra = []
    endif
    let l:dirty = {}
    for l:file in l:names + l:extra
        if l:file !=# ''
            let l:dirty[a:root . '/' . l:file] = 1
        endif
    endfor
    return l:dirty
endfunction

function! s:AgentRel(root, path) abort
    let l:prefix = a:root ==# '/' ? '/' : a:root . '/'
    if stridx(a:path, l:prefix) == 0
        return a:path[len(l:prefix):]
    endif
    return a:path
endfunction

function! AgentContext() abort
    let l:root = s:AgentRoot()
    let l:dirty = s:AgentDirty(l:root)
    let l:total = tabpagenr('$')
    let l:path = expand('%:p')
    let l:name = l:path ==# '' ? '(unnamed)' : s:AgentRel(l:root, l:path)
    let l:pos = l:path ==# '' ? '' : ':' . line('.')
    let l:lines = [
    \   'Context from my editor session (open in a split beside you).',
    \   'Treat this as your starting point: the files below are already open in my editor.',
    \   '',
    \   printf('Active file: %s%s (tab %d of %d)', l:name, l:pos, tabpagenr(), l:total),
    \   'Tabs:',
    \ ]
    for l:t in range(1, l:total)
        let l:info = get(getbufinfo(winbufnr(win_getid(tabpagewinnr(l:t), l:t))), 0, {})
        let l:full = get(l:info, 'name', '')
        let l:disp = l:full ==# '' ? '(unnamed)' : s:AgentRel(l:root, l:full)
        call add(l:lines, printf('  %d. %s%s', l:t, l:disp, has_key(l:dirty, l:full) ? ' *' : ''))
    endfor
    if !empty(l:dirty)
        call add(l:lines, 'Dirty/untracked files:')
        for l:file in sort(keys(l:dirty))
            call add(l:lines, '  - ' . s:AgentRel(l:root, l:file))
        endfor
    endif
    call add(l:lines, 'Repo root: ' . l:root)
    return join(l:lines, "\n")
endfunction

" opencode's TUI has no prompt argument: paste the context into its input box
" once it has booted, then send a raw Enter. send-keys/paste go through
" bracketed paste, so the newlines in the context cannot submit early.
function! s:AgentSeed(transport, id, ctx) abort
    if a:transport ==# 'wezterm'
        call system(s:AgentSh(['wezterm', 'cli', 'send-text', '--pane-id', a:id, a:ctx]))
        call timer_start(300, {-> system(s:AgentSh(['wezterm', 'cli', 'send-text', '--no-paste', '--pane-id', a:id, "\r"]))})
    elseif a:transport ==# 'tmux'
        call system(s:AgentSh(['tmux', 'load-buffer', '-b', 'agentctx', '-']), a:ctx)
        call system(s:AgentSh(['tmux', 'paste-buffer', '-p', '-b', 'agentctx', '-t', a:id]))
        call timer_start(300, {-> system(s:AgentSh(['tmux', 'send-keys', '-t', a:id, 'Enter']))})
    else
        call term_sendkeys(a:id, "\e[200~" . a:ctx . "\e[201~")
        call timer_start(300, {-> term_sendkeys(a:id, "\r")})
    endif
endfunction

function! AgentOpen(which) abort
    let l:root = s:AgentRoot()
    let l:ctx = AgentContext()
    if a:which ==# 'claude'
        let l:cmd = ['claude', l:ctx]
    elseif a:which ==# 'cursor'
        let l:cmd = ['cursor-agent', l:ctx]
    elseif a:which ==# 'opencode'
        let l:cmd = ['opencode']
    else
        return
    endif
    if !executable(l:cmd[0])
        echohl ErrorMsg | echomsg 'Agent not installed: ' . l:cmd[0] | echohl None
        return
    endif

    let l:transport = ''
    let l:id = ''
    if exists('$WEZTERM_PANE') && executable('wezterm')
        let l:out = systemlist(s:AgentSh(['wezterm', 'cli', 'split-pane', '--right', '--percent', '45', '--cwd', l:root, '--'] + l:cmd))
        if v:shell_error != 0
            echohl ErrorMsg | echomsg 'wezterm split-pane failed: ' . join(l:out) | echohl None
            return
        endif
        let l:transport = 'wezterm'
        let l:id = get(l:out, 0, '')
        call system(s:AgentSh(['wezterm', 'cli', 'activate-pane', '--pane-id', l:id]))
    elseif exists('$TMUX') && executable('tmux')
        let l:out = systemlist(s:AgentSh(['tmux', 'split-window', '-h', '-P', '-F', '#{pane_id}', '-c', l:root, '--'] + l:cmd))
        if v:shell_error != 0
            echohl ErrorMsg | echomsg 'tmux split-window failed: ' . join(l:out) | echohl None
            return
        endif
        let l:transport = 'tmux'
        let l:id = get(l:out, 0, '')
    else
        " No WezTerm/tmux: run the agent in a :terminal split instead.
        botright split
        let l:id = term_start(l:cmd, {'curwin': 1, 'cwd': l:root})
        let l:transport = 'term'
    endif

    if a:which ==# 'opencode'
        if l:transport ==# 'term'
            if l:id > 0
                call timer_start(1500, {-> s:AgentSeed('term', l:id, l:ctx)})
            endif
        elseif l:id !=# ''
            call timer_start(1500, {-> s:AgentSeed(l:transport, l:id, l:ctx)})
        endif
    endif
endfunction

function! s:AgentEcho() abort
    for l:line in split(AgentContext(), "\n")
        echomsg l:line
    endfor
endfunction

command! Ccontext call s:AgentEcho()
command! Cclaude call AgentOpen('claude')
command! Ccursor call AgentOpen('cursor')
command! Copencode call AgentOpen('opencode')

" Plugins managed by vim-plug (downloaded to ~/.vim/autoload/plug.vim by the installer)
if glob('~/.vim/autoload/plug.vim') != ''
    call plug#begin('~/.vim/plugged')
    " fzf is installed as a devtool (brew/winget); fzf#install() only needed if not
    Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
    " :Files fuzzy file finder, :Rg grep via ripgrep
    Plug 'junegunn/fzf.vim'
    " JS + React/JSX syntax highlighting (vim-jsx-pretty must load after the JS plugin)
    Plug 'pangloss/vim-javascript'
    Plug 'MaxMEllon/vim-jsx-pretty'
    " gcc / gc comment toggling, like Comment.nvim
    Plug 'tpope/vim-commentary'
    call plug#end()

    " Cmd+/ (WezTerm sends Ctrl+_) toggles comments, like Neovim.
    nmap <C-_> gcc
    xmap <C-_> gc

    " Same pickers and keys as the shell and Neovim: Cmd+P (WezTerm sends
    " Ctrl+P) finds files, <Space>/ searches text. Enter opens in a new tab,
    " Ctrl+O opens here.
    let s:pick_header = ['--expect=ctrl-o', '--header', 'enter: new tab  |  ctrl-o: here']
    let s:bat = executable('bat') ? 'bat --style=numbers --color=always ' : 'cat '

    function! s:PickFiles(lines) abort
        if len(a:lines) < 2
            return
        endif
        let l:cmd = a:lines[0] ==# 'ctrl-o' ? 'edit' : 'tabedit'
        for l:file in a:lines[1:]
            execute l:cmd . ' ' . fnameescape(l:file)
        endfor
    endfunction

    function! s:PickGrep(lines) abort
        if len(a:lines) < 2
            return
        endif
        let l:cmd = a:lines[0] ==# 'ctrl-o' ? 'edit' : 'tabedit'
        let l:parts = split(a:lines[1], ':')
        execute l:cmd . ' +' . l:parts[1] . ' ' . fnameescape(l:parts[0])
    endfunction

    function! s:FindFiles() abort
        call fzf#run(fzf#wrap({
        \   'source': 'rg --files --hidden -g "!.git"',
        \   'sink*': function('s:PickFiles'),
        \   'options': ['--multi', '--preview', s:bat . '{}'] + s:pick_header,
        \ }))
    endfunction

    function! s:SearchText() abort
        let l:rg = 'rg -i --hidden -g "!.git" --line-number --no-heading --color=never'
        call fzf#run(fzf#wrap({
        \   'source': 'true',
        \   'sink*': function('s:PickGrep'),
        \   'options': ['--disabled', '--prompt', 'search> ',
        \               '--bind', 'change:reload:' . l:rg . ' -e {q} || true',
        \               '--delimiter', ':', '--preview', s:bat . '{1}'] + s:pick_header,
        \ }))
    endfunction

    nnoremap <silent> <C-p> :call <SID>FindFiles()<CR>
    nnoremap <silent> <Leader>/ :call <SID>SearchText()<CR>
endif